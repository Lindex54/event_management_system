# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=event_management_system

# Express server
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# Leave this blank in both local dev and on Hostinger. The frontend's
# next.config.ts rewrite proxy (BACKEND_ORIGIN) makes the session cookie
# same-origin from the browser's point of view, so no Domain attribute is
# needed. Only set this if the frontend and backend share a real parent
# domain you control (for example api.example.com under example.com) AND
# you are not using the rewrite proxy. Never set it to a shared hosting
# platform's own domain (e.g. .hostingersite.com) — browsers silently
# reject cookies whose Domain is a public suffix, which breaks login
# without any visible error.
COOKIE_DOMAIN=

# Gmail SMTP (mail sending)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM_NAME=Event Management System
MAIL_FROM_ADDRESS=
