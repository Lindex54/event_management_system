# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=event_management_system

# Express server
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# Leave blank locally. In production, use the shared parent domain (for example,
# .example.com) so api.example.com sessions are visible to example.com.
COOKIE_DOMAIN=

# Gmail SMTP (mail sending)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM_NAME=Event Management System
MAIL_FROM_ADDRESS=
