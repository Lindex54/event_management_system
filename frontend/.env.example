# Public backend URL. Next.js embeds this value during `npm run build`.
# Local dev: point directly at the backend.
NEXT_PUBLIC_API_URL=http://localhost:5000

# --- Production on Hostinger (or any host where the frontend and backend end
# up on two unrelated domains) ---
# Leave NEXT_PUBLIC_API_URL set to an EMPTY string instead, and set
# BACKEND_ORIGIN (server-side only, never sent to the browser) to the
# backend's real HTTPS origin. next.config.ts then transparently proxies
# /api/* and /uploads/* through this Next.js server to the backend, so every
# request the browser makes stays same-origin — which is what lets the
# session cookie survive page navigations. See DEPLOYMENT.md.
#
# NEXT_PUBLIC_API_URL=
# BACKEND_ORIGIN=https://api-xxxx.hostingersite.com
